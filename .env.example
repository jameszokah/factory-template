# Factory configuration. `bun run setup` copies this to .env and generates secrets.
# Both apps (server and UI) read this one file at the repository root.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Public origin the browser uses. All OAuth callbacks are derived from it.
# MASTRACODE_PUBLIC_URL=http://localhost:4111
# PORT=4111

# PostgreSQL with pgvector. `bun run db:up` starts one at this address.
DATABASE_URL=postgres://factory:factory@localhost:54330/factory

# Encrypts stored model keys and integration tokens (base64, 32 bytes).
# Keep it stable and backed up: losing it makes stored credentials unreadable.
FACTORY_CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Auth: better-auth (default, self-hosted email + password) | workos | none
# ---------------------------------------------------------------------------
AUTH_PROVIDER=better-auth
BETTER_AUTH_SECRET=
# Set to "disabled" to close public sign-up once your team has accounts.
# AUTH_SIGN_UP=enabled

# AUTH_PROVIDER=workos
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_COOKIE_PASSWORD=          # 32+ characters
# WORKOS_REDIRECT_URI=             # defaults to <MASTRACODE_PUBLIC_URL>/auth/callback

# ---------------------------------------------------------------------------
# Integrations: each one turns on when its whole group is set.
# ---------------------------------------------------------------------------
# GitHub App (https://factory.mastra.ai/configure/github)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=          # PEM; "\n" escapes are accepted
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# GITHUB_APP_WEBHOOK_SECRET=

# GitLab
# GITLAB_ACCESS_TOKEN=
# GITLAB_ACCESS_TOKEN_TYPE=personal  # or group
# GITLAB_BASE_URL=
# GITLAB_WEBHOOK_SECRET=

# Linear
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# Jira Cloud
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# Slack
# SLACK_APP_TOKEN=
# SLACK_APP_SIGNING_SECRET=
# SLACK_APP_BOT_TOKEN=
# SLACK_APP_CLIENT_ID=
# SLACK_APP_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Where local sandboxes check out repositories. Default: ~/.factory/sandboxes
# FACTORY_LOCAL_SANDBOX_ROOT=
# Embedding model for memory recall, e.g. openai/text-embedding-3-small.
# Unset embeds locally with fastembed.
# FACTORY_EMBEDDER=
# Model providers every account may use on this server's credentials.
# FACTORY_DEPLOYMENT_MODEL_PROVIDERS=amazon-bedrock,google-vertex
# Secret for OAuth `state` signing. Defaults to BETTER_AUTH_SECRET.
# FACTORY_STATE_SECRET=
# Only when the UI is hosted on a different origin than the server.
# MASTRACODE_ALLOWED_ORIGINS=
# Mastra/PostHog telemetry is disabled by the scripts. Set to 0 to opt in.
# MASTRA_TELEMETRY_DISABLED=1

# Never set MASTRA_SHARED_API_URL / MASTRA_PLATFORM_*: this Factory is
# self-hosted and refuses to boot with Mastra Platform services configured.
