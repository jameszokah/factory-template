{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/vite.config.ts", "vitest.config.ts", "e2e/**/*"],
  "exclude": ["node_modules", "dist"]
}
