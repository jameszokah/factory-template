    "@mastra/memory": "1.41.3",
    "@mastra/playground-ui": "71.0.0",
    "@mastra/react": "1.16.0",
    "@nangohq/frontend": "0.71.6",
    "@shikijs/themes": "4.6.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.22",
    "date-fns": "4.4.0",
    "lucide-react": "^1.61.0",
